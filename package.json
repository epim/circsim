{
  "name": "circsim",
  "version": "0.2.3",
  "description": "Cross-platform Electron PCB simulator",
  "main": "./out/main/index.js",
  "author": "circsim maintainers <epim@users.noreply.github.com>",
  "license": "MIT",
  "config": {
    "circsim": {
      "ngspiceVersion": "46"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.simhost.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:ngspice": "node scripts/fetch-ngspice.mjs",
    "test:integration": "vitest run --reporter=verbose .integration.test",
    "test:e2e": "playwright test --config playwright.config.ts",
    "license:check": "node scripts/license-hygiene.mjs",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.1.7",
    "koffi": "^2.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.163.0",
    "troika-three-text": "^0.49.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.60.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/three": "^0.163.0",
    "@typescript-eslint/eslint-plugin": "^7.7.1",
    "@typescript-eslint/parser": "^7.7.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.5.0",
    "7zip-min": "^3.0.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "eslint": "^8.57.0",
    "js-yaml": "^4.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^1.5.0"
  }
}
